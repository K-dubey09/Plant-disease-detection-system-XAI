# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc.) — NEVER commit
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio / IntelliJ
*.iml
.idea/
*.ipr
*.iws
.navigation/
captures/

# Keystore files — NEVER commit signing keys
*.jks
*.keystore
# Exception: the pinned DEBUG keystore is committed so every CI/local debug build shares one
# signer (otherwise ephemeral CI runners regenerate the debug key and sideload upgrades fail).
# Debug keys are non-secret (standard Android credentials). NEVER do this for a release key.
!app/keystores/debug.keystore

# Google Services (e.g. APIs or Firebase) — not used now, but keep ignored
google-services.json

# Android NDK
obj/

# Kotlin
.kotlin/

# OS files
.DS_Store
Thumbs.db

# Credentials / secrets — defense in depth
*.pem
*.key
secrets.properties

# Model conversion artifacts — the trained model lives in the private Kaggle dataset
# (kushagradubey09/plant-disease-xai-models) and is pulled by CI. Only the conversion
# scripts under models/conversion/ are tracked. The repo's app/src/main/assets/models/
# keeps the untrained demo .tflite as a local-build fallback.
models/source/
models/onnx/
models/saved_model/
models/saved_model_int8src/
models/tflite/
models/metadata/
